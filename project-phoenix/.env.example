# Application
APP_NAME=Project Phoenix
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=true

# Database

DATABASE_URL=sqlite+aiosqlite:///./phoenix.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT Auth
JWT_SECRET=change-me-to-a-random-jwt-secret
JWT_LIFETIME_SECONDS=3600
JWT_REFRESH_LIFETIME_SECONDS=604800

# Xendit
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# RajaOngkir
RAJAONGKIR_API_KEY=
RAJAONGKIR_ACCOUNT_TYPE=pro

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=phoenix-assets
R2_PUBLIC_URL=

# Email (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# Sentry
SENTRY_DSN=

# Default language
DEFAULT_LANGUAGE=id



# run the server :: python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload